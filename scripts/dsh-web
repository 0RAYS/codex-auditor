#!/usr/bin/env python3
import os
import re
import select
import subprocess
from pathlib import Path
import sys
from datetime import datetime


DSH_BIN = '/usr/bin/dsh'
LAUNCH_FILE = Path('/run/dsh-token')
TOKEN_RE = re.compile(r'[?&]token=([^&#\s]+)')


def log(msg, stdout: bool = True):
    print(
        datetime.now().strftime('%m/%d %H:%M:%S'),
        msg,
        flush=True,
        file=sys.stdout if stdout else sys.stderr,
    )


def relay(name, line, pid):
    line = line.decode('utf-8', errors='replace').rstrip('\r')
    log(f'[dsh {name}] {line}')
    if name == 'stdout':
        match = TOKEN_RE.search(line)
        if match:
            LAUNCH_FILE.write_text(f'{pid}\n{match.group(1)}\n')


def main():
    LAUNCH_FILE.unlink(missing_ok=True)
    if not os.path.isfile(DSH_BIN):
        log(f'{DSH_BIN} not present, please start service after installing dsh')
        return 0

    args = ['--host', '127.0.0.1', '--port', '3080', '--no-open']
    hosts = [
        host.strip()
        for host in os.environ.get('PUBLIC_HOSTS', '').split(',')
        if host.strip()
    ]
    trusted_hosts = [item for host in hosts for item in ('--trusted-host', host)]
    dsh_proc = subprocess.Popen(
        [DSH_BIN, 'web', *args, *trusted_hosts],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    streams = {dsh_proc.stdout: ('stdout', b''), dsh_proc.stderr: ('stderr', b'')}
    while streams:
        readable, _, _ = select.select(streams, [], [])
        for stream in readable:
            name, buffered = streams[stream]
            data = os.read(stream.fileno(), 4096)
            if not data:
                if buffered:
                    relay(name, buffered, dsh_proc.pid)
                del streams[stream]
                continue

            lines = (buffered + data).split(b'\n')
            streams[stream] = (name, lines.pop())
            for line in lines:
                relay(name, line, dsh_proc.pid)
    status = dsh_proc.wait()
    LAUNCH_FILE.unlink(missing_ok=True)
    return status


if __name__ == '__main__':
    raise SystemExit(main())
